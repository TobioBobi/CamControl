<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>1.3.0</Version>
    <ApplicationIcon>../packaging/Assets/CamControl.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CameraUiCheck" />
    <Resource Include="../packaging/Assets/CamControl.ico" Link="resources/Camera.ico" />
    <EmbeddedResource Include="../docs/privacy.md" LogicalName="CamControl.PrivacyPolicy" />
    <EmbeddedResource Include="../docs/privacy.en.md" LogicalName="CamControl.PrivacyPolicy.en" WithCulture="false" />
  </ItemGroup>

</Project>
