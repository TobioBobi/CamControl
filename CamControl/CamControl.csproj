<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../docs/privacy.md" LogicalName="CamControl.PrivacyPolicy" />
    <None Remove="resources\GlyphDown_16x.png" />
    <None Remove="resources\GlyphLeft_16x.png" />
    <None Remove="resources\GlyphRight_16x.png" />
    <None Remove="resources\GlyphUp_16x.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources\GlyphDown_16x.png" />
    <EmbeddedResource Include="resources\GlyphLeft_16x.png" />
    <EmbeddedResource Include="resources\GlyphRight_16x.png" />
    <EmbeddedResource Include="resources\GlyphUp_16x.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
